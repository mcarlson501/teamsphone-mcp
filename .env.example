# Single-token form; recorded in the audit trail as client "default".
# For several callers use one Auth__ClientTokens__<clientId> per client instead,
# which also lets you rotate a token with no downtime.
TEAMSPHONE_MCP_BEARER_TOKEN=
# Auth__ClientTokens__orchestrator=
# Auth__ClientTokens__inspector=
# Restrict one client to simulation only. Unlike the whatIfMode a client asks for at
# initialize, this ceiling is set here and the client cannot decline it. The client id
# must match a token above or the server refuses to start.
# Auth__ClientPolicy__inspector__WhatIfMode=true
TEAMSPHONE_MCP_CONFIRMATION_TOKEN_KEY=
TEAMSPHONE_MCP_MODE=whatif
TEAMSPHONE_MCP_PORT=5199

TEAMSPHONE_MCP_TENANT_ID=
TEAMSPHONE_MCP_CLIENT_ID=
TEAMSPHONE_MCP_CERTIFICATE_PATH=
# Optional for a manually supplied password-protected PFX; guided setup leaves this blank.
TEAMSPHONE_MCP_CERTIFICATE_PASSWORD=