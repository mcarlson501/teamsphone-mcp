# Template for local live-tenant testing. Copy to .env.integration (gitignored)
# and fill in your own values. Never commit real tenant values.
#
# Load with:   set -a; source .env.integration; set +a
# Then run:    ./scripts/live-test.sh <dotnet test args>
#
# The host's credential keys contain a hyphen (Credentials__dev-tenant__…), which
# zsh cannot use as a variable name, so they are held in shell-safe names here and
# translated by scripts/live-test.sh.

# --- The app-only credential for credentialRef "dev-tenant" -------------------
TEAMSPHONE_MCP_DEV_PFX_PASSWORD=''
TP_CRED_TENANT_ID=''
TP_CRED_CLIENT_ID=''
TP_CRED_CERT_PATH="$HOME/.config/teamsphone-mcp/teamsphone-mcp-dev.pfx"

# --- Shared integration inputs ------------------------------------------------
TEAMSPHONE_MCP_IT_TENANT_ID=''
TEAMSPHONE_MCP_IT_CREDENTIAL_REF='dev-tenant'
TEAMSPHONE_MCP_IT_USER_UPN=''

# --- M4 write-pipeline demo (move-number-between-users) -----------------------
# source: a user who currently holds the number
# target: a user account (not a resource account) licensed for the number's type,
#         with NO number assigned
TEAMSPHONE_MCP_IT_MOVE_SOURCE_UPN=''
TEAMSPHONE_MCP_IT_MOVE_TARGET_UPN=''
# Optional. Defaults to whatever number the source user currently holds.
TEAMSPHONE_MCP_IT_MOVE_NUMBER=''
# Optional. A target the tenant cannot accept (a resource account, or a user missing
# the licence the number type requires) — proves preflight blocks it and issues no
# token. This test writes nothing.
TEAMSPHONE_MCP_IT_MOVE_INELIGIBLE_TARGET_UPN=''

# --- M5 Phase D composite round trip ------------------------------------------
# A numbered, enterprise-voice-enabled user with a validated emergency location,
# no direct call queue memberships, and no caller ID policy. When unset, the test
# uses TEAMSPHONE_MCP_IT_MOVE_SOURCE_UPN.
TEAMSPHONE_MCP_IT_PHASE_D_USER_UPN=''
